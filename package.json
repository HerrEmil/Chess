{
  "name": "chess",
  "version": "1.0.0",
  "scripts": {
    "build": "rm -rf build && mkdir -p build/chess && esbuild src/chess/main.ts --bundle --minify --format=esm --target=es2022 --outfile=build/chess/main.js && cp src/index.html src/default.css src/favicon.ico src/robots.txt build/ && node scripts/inline-css.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "lint": "eslint .",
    "serve": "npx -y http-server build",
    "start": "npm run build && npm run serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.html": "html-validate",
    "*.css": "stylelint",
    "*.{png,jpg,jpeg,webp,avif}": "node tools/check-image-size.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HerrEmil/Chess.git"
  },
  "bugs": {
    "url": "https://github.com/HerrEmil/Chess/issues"
  },
  "homepage": "https://github.com/HerrEmil/Chess#readme",
  "devDependencies": {
    "@eslint/js": "^9",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "html-validate": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "eslint-config-prettier": "^10",
    "globals": "^16",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "size-limit": "^11",
    "@size-limit/preset-app": "^11",
    "@types/node": "^25",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vitest": "^4.0.18"
  }
}
