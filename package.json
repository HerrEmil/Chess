{
  "name": "chess",
  "version": "1.0.0",
  "scripts": {
    "build": "rm -rf build && tsc && mkdir -p build && cp src/index.html src/default.css src/favicon.ico build/",
    "lint": "eslint src/chess/*",
    "serve": "npx -y http-server build -o",
    "start": "npm run build && npm run serve",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HerrEmil/Chess.git"
  },
  "bugs": {
    "url": "https://github.com/HerrEmil/Chess/issues"
  },
  "homepage": "https://github.com/HerrEmil/Chess#readme",
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "globals": "^16",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@types/jquery": "^3.5.5",
    "@types/jqueryui": "^1.12.15"
  },
  "resolutions": {
    "brace-expansion": ">=1.1.12",
    "ajv": "~6.14.0"
  }
}
