{
  "name": "chess",
  "version": "1.0.0",
  "scripts": {
    "build": "rm -rf build && mkdir -p build/chess && esbuild src/chess/main.ts --bundle --minify --format=esm --target=es2022 --outfile=build/chess/main.js && cp src/index.html src/default.css src/favicon.ico build/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "lint": "eslint 'src/chess/**/*.ts'",
    "serve": "npx -y http-server build",
    "start": "npm run build && npm run serve",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HerrEmil/Chess.git"
  },
  "bugs": {
    "url": "https://github.com/HerrEmil/Chess/issues"
  },
  "homepage": "https://github.com/HerrEmil/Chess#readme",
  "devDependencies": {
    "@eslint/js": "^9",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "globals": "^16",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "size-limit": "^11",
    "@size-limit/preset-app": "^11",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.0.18"
  },
  "resolutions": {
    "brace-expansion": ">=1.1.12",
    "ajv": "~6.14.0"
  }
}
